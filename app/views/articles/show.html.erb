<div class="article">

  <h1><%= @article.title %></h1>

  <p>
    <%= @article.description %>
  </p>

  <p>
    Written by:
    <strong><%= @article.user.username %></strong>
  </p>

</div>

<%= link_to "Back", articles_path, class: "button" %>

<% if logged_in? && @article.user == current_user %>

  <%= link_to "Edit",
              edit_article_path(@article),
              class: "button" %>

  <%= button_to "Delete",
                article_path(@article),
                method: :delete,
                class: "button danger",
                data: { turbo_confirm: "Are you sure?" } %>

<% end %>