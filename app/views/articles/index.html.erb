<h1>All Articles</h1>

<% if logged_in? %>
  <%= link_to "Create New Article",new_article_path, class: "button" %>
<% end %>

<br><br>

<% @articles.each do |article| %>

  <div class="article">

    <h2>
      <%= article.title %>
    </h2>

    <p>
      <%= article.description %>
    </p>

    <p>
      Written by:
      <strong><%= article.user.username %></strong>
    </p>

    <%= link_to "View",article_path(article),class: "button" %>

  </div>

<% end %>